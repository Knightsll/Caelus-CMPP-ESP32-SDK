CONFIG_MCP_HTTP_AUTH_ENABLE=y
CONFIG_MCP_HTTP_AUTH_BEARER_TOKEN=""
# CONFIG_MCP_HTTP_AUTH_JWT_VERIFY_ENABLE is not set
# CONFIG_MCP_HTTP_AUTH_SCOPE_ENABLE is not set
# CONFIG_MCP_HTTP_OAUTH_METADATA_ENABLE is not set
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y
CONFIG_CMPP_BOARD_PROVISIONING_SSID_PREFIX="Caelus-Board"
CONFIG_CMPP_BOARD_HOSTNAME_PREFIX="caelus-board"
CONFIG_CMPP_BOARD_HTTP_PORT=8080
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
# CONFIG_ESP_CONSOLE_UART_DEFAULT is not set
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_ESP_PROTOCOMM_SUPPORT_SECURITY_VERSION_1=y
CONFIG_CMPP_BOARD_BLE_PROVISIONING=y
CONFIG_CMPP_BOARD_BLE_POP="caelus1234"
