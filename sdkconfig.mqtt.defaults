CONFIG_MCP_HTTP_AUTH_ENABLE=y
CONFIG_MCP_HTTP_AUTH_BEARER_TOKEN=""
# CONFIG_MCP_HTTP_AUTH_JWT_VERIFY_ENABLE is not set
# CONFIG_MCP_HTTP_AUTH_SCOPE_ENABLE is not set
# CONFIG_MCP_HTTP_OAUTH_METADATA_ENABLE is not set
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_mqtt.csv"
CONFIG_CMPP_SDK_PROVISIONING_SSID_PREFIX="Caelus-Board"
CONFIG_CMPP_SDK_DISPLAY_NAME_PREFIX="Caelus Board"
CONFIG_CMPP_SDK_HOSTNAME_PREFIX="caelus-board"
CONFIG_CMPP_SDK_IDENTITY_NAMESPACE="mcp_light"
CONFIG_CMPP_SDK_HTTP_PORT=8080
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
# CONFIG_ESP_CONSOLE_UART_DEFAULT is not set
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_ESP_PROTOCOMM_SUPPORT_SECURITY_VERSION_1=y
CONFIG_CMPP_SDK_BLE_PROVISIONING=y
CONFIG_CMPP_SDK_BLE_POP="caelus1234"
CONFIG_CMPP_SDK_MQTT_ENABLE=y
