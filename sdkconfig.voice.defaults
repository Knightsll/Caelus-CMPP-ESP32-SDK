# Layer after sdkconfig.defaults; build with a separate SDKCONFIG and build dir.
CONFIG_CMPP_VOICE_BOARD=y
CONFIG_CMPP_BOARD_PROVISIONING_SSID_PREFIX="Caelus-Voice"
CONFIG_CMPP_BOARD_HOSTNAME_PREFIX="caelus-voice"
CONFIG_HTTPD_WS_SUPPORT=y
CONFIG_HTTPD_WS_PRE_HANDSHAKE_CB_SUPPORT=y
CONFIG_HTTPD_WS_POST_HANDSHAKE_CB_SUPPORT=y
CONFIG_CODEC_ES7210_SUPPORT=y
CONFIG_CODEC_ES8311_SUPPORT=y
CONFIG_LWIP_MAX_SOCKETS=16
# Two HTTP servers reserve six sockets; allow two MCP clients plus media.
# Bound retained command notifications; state remains available on demand.
CONFIG_MCP_HTTP_SSE_REPLAY_DEPTH=8
# D6FD1C: 8MB AP_3v3 verified by boot memtest and four 7MiB pattern passes.
# Only explicitly allocated bulk buffers use PSRAM; normal malloc stays internal.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_40M=y
CONFIG_SPIRAM_USE_CAPS_ALLOC=y
CONFIG_SPIRAM_MEMTEST=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.voice.csv"
# No substitute wake word is bundled. A trained 小白小白 WakeNet9 model is pending.
CONFIG_CMPP_VOICE_WAKE_WORD="小白小白"
CONFIG_CMPP_VOICE_WAKE_MODEL="xiaobai_micro_v1"
CONFIG_CMPP_VOICE_WAKE_SILENCE_MS=1200
CONFIG_MODEL_IN_FLASH=y
CONFIG_SR_VADN_WEBRTC=y

# TFLite initialization and embedded PCM self-test run during board startup.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

CONFIG_CMPP_VOICE_FOLLOWUP_TIMEOUT_MS=15000
CONFIG_CMPP_VOICE_AEC=y
CONFIG_CMPP_VOICE_BARGE_MIN_RMS=1000
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y
